{
  "name": "ferroviva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "build": "next build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev": "next dev",
    "start": "next start",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:database": "node --experimental-strip-types --env-file=.env.production.local scripts/setup-database.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "preview": "pnpm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "pnpm run build:cloudflare && pnpm run deploy:cloudflare",
    "deploy:cloudflare": "opennextjs-cloudflare deploy -- --keep-vars",
    "upload": "pnpm run build:cloudflare && opennextjs-cloudflare upload -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@electric-sql/pglite": "0.6.0",
    "@vercel/analytics": "1.6.1",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "react-leaflet": "^5.0.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "wrangler": "^4.166.0"
  }
}
